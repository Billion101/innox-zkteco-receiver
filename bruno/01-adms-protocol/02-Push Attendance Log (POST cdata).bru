meta {
  name: 02 - Push Attendance Log (POST cdata)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/iclock/cdata?SN={{deviceSN}}&table=ATTLOG&Stamp=9999
  body: text
  auth: none
}

params:query {
  SN: {{deviceSN}}
  table: ATTLOG
  Stamp: 9999
}

headers {
  Content-Type: text/plain
}

body:text {
  13	2026-09-28 08:55:00	0	15	0
  16	2026-09-28 09:05:00	0	15	0
}

docs {
  Simulates ZKTeco device pushing raw biometric punch logs.
  Format: <PIN>\t<YYYY-MM-DD HH:MM:SS>\t<PunchState>\t<VerifyType>\t<WorkCode>
  VerifyType: 1=Fingerprint, 2=Password, 4=RFID Card, 15=Face Scan.
  Expected Response: "OK: 2\n"
}
